# Local-only configuration for scripts/ — copy to scripts/.env and fill in.
# scripts/.env is git-ignored. NEVER commit a real service-account key.

# Absolute path to a Firebase service-account JSON key.
# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# Prefer a location OUTSIDE this repository working tree.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json

# Only needed when running against the local Firebase emulators instead of a
# real project (leave commented for normal production onboarding):
# GOOGLE_CLOUD_PROJECT=demo-nemt-hub
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Firebase configuration — copy to .env and fill with your Firebase project values.
# Never commit .env.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google Maps Platform Geocoding API key — used by the trip form to resolve
# a typed address to coordinates. Optional: without it, trip forms fall back
# to manual latitude/longitude entry. Create at
# https://console.cloud.google.com/apis/credentials on the same GCP project
# as your Firebase project (or a separate one), enable "Geocoding API" and
# "Maps JavaScript API", restrict the key by HTTP referrer to your dev/prod
# origins, and restrict it to those two APIs only.
VITE_GOOGLE_MAPS_API_KEY=